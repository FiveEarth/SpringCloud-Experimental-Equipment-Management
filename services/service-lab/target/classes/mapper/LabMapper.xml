<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="edu.graduation.lab.dao.LabDao">

    <resultMap id="LabResultMap" type="edu.graduation.lab.bean.Lab">
        <id column="id" property="id"/>
        <result column="lab_name" property="labName"/>
        <result column="lab_location" property="labLocation"/>
        <result column="lab_manager" property="labManager"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="LabResultMap">
        SELECT id, lab_name, lab_location, lab_manager, status, create_time, update_time
        FROM lab_laboratory
    </select>

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO lab_laboratory (lab_name, lab_location, lab_manager, status)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.labName}, #{item.labLocation}, #{item.labManager}, #{item.status})
        </foreach>
    </insert>

    <delete id="deleteBatch" parameterType="java.util.List">
        DELETE FROM lab_laboratory
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>